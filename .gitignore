# Secrets — NEVER commit (DEV_ENVIRONMENT §15, RICE §31)
.env
.env.*
!.env.example
secrets/*
!secrets/README.md
!secrets/.gitkeep
*.key
*.pem
*.age
*.sops
*.sops.yaml
*.sops.yml
# VPN
*.ovpn
*.conf.vpn
wg*.conf
# direnv/devenv
.direnv/
.devenv/
.devenv.*
# Cloud / auth
.aws/
.azure/
.gcp/
*.cloud
# AWS STS secrets — not committed
.config/aws-sts.env
.aws-sts.env
# Pi/OpenCode auth (outside repo, but ensure no accidental copy)
.pi/
.opencode/
# Company skills — keep outside repo (TAP claude-plugins) but usable via pi extraArgs.
# Repo-owned pi skills are tracked; everything else under pi/skills/ stays ignored.
pi/skills/*
!pi/skills/repo-understanding/
!pi/skills/repo-understanding/**
!pi/skills/learnings/
!pi/skills/learnings/**
!pi/skills/vageesh/
!pi/skills/vageesh/**
# pi brain, context, themes, and extensions are safe to commit
!pi/brain/
!pi/brain/**
!pi/context.md
!pi/themes/
!pi/themes/*.json
# pi/prompts intentionally empty — skills preferred over prompt templates
# keep the directory for future intentional templates; .gitkeep is tracked
!pi/prompts/
!pi/prompts/.gitkeep

# Nix build outputs
result
result-*
.direnv/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary
tmp/
temp/

# Dummy MCP — local deps, never committed (rebuilt via `npm install --registry https://registry.npmjs.org` in pi/mcp-servers/dummy)
pi/mcp-servers/dummy/node_modules/

# Logs
*.log
