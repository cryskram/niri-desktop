# Secrets — NEVER commit (DEV_ENVIRONMENT §15, RICE §31)
.env
.env.*
!.env.example
secrets/*
!secrets/README.md
!secrets/.gitkeep
*.key
*.pem
*.age
*.sops
*.sops.yaml
*.sops.yml
# VPN
*.ovpn
*.conf.vpn
wg*.conf
# direnv/devenv
.direnv/
.devenv/
.devenv.*
# Cloud / auth
.aws/
.azure/
.gcp/
*.cloud
# AWS STS secrets — not committed
.config/aws-sts.env
.aws-sts.env
# Pi/OpenCode auth (outside repo, but ensure no accidental copy)
.pi/
.opencode/
# Company skills — keep outside repo (TAP claude-plugins) but usable via pi extraArgs
pi/skills/
# pi/prompts + pi/themes safe to commit (external plan/review + catppuccin)
!pi/prompts/
!pi/prompts/*.md
!pi/themes/
!pi/themes/*.json

# Nix build outputs
result
result-*
.direnv/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary
tmp/
temp/

# Logs
*.log
